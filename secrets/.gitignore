# Ignore secrets by default; allow committing encrypted variants.
#
# Convention:
# - decrypted/plaintext secrets stay ignored
# - encrypted secrets end in one of: *.sops.yml, *.sops.yaml, *.enc.yml, *.enc.yaml

# Default ignore for this folder
*

# Keep the tooling tracked
!.gitignore
!README.md
!Dockerfile
!sops-run.sh
!sops_manager.py

# Allow committing encrypted files in this folder too (same convention)
!*.sops.yml
!*.sops.yaml
!*.enc.yml
!*.enc.yaml
# Allow the secrets subtree to be visible to gitignore negations below
!secrets/

# Ignore everything under secrets/, but keep directories visible so we can
# un-ignore specific encrypted files inside nested folders.
secrets/**/*
!secrets/**/
!secrets/**/*.sops.yml
!secrets/**/*.sops.yaml
!secrets/**/*.enc.yml
!secrets/**/*.enc.yaml
